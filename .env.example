# ==========================================
# Police Station Management System (PSMS)
# Environment Variables Configuration
# ==========================================

# Flask Environment & Port
FLASK_APP=run.py
FLASK_ENV=development
PORT=5050

# Secret Key for Sessions & CSRF Protection
# REQUIRED in production! Generate a secure 64-char key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database URI (Leave empty for SQLite in local dev)
# Local SQLite default: instance/psms.db
# Render PostgreSQL example:
# DATABASE_URL=postgresql://psms_db_user:password@dpg-xxxx.render.com/psms_db
DATABASE_URL=

# Pagination Settings
ITEMS_PER_PAGE=10
